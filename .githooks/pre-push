#!/usr/bin/env bash
# AGOS governance: re-check every commit being pushed.
z40=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && { echo "G2: حذف فرع بعيد ممنوع / deleting a remote branch is forbidden"; exit 1; }
  if [ "$remote_sha" = "$z40" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  python3 "$(git rev-parse --show-toplevel)/tools/governance/check_commit.py" --range "$range" || exit 1
done
